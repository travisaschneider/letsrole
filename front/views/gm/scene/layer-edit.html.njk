<div class="form-group">
    <label>{{ __('Name') }}</label>
    <input type="text" name="name" value="{{ name|e }}" class="form-control">
</div>

<div class="form-group">
    <label>{{ __('Options') }}</label><br>
    <div class="form-check form-check-inline" data-toggle="tooltip" data-placement="top" title="{{ __('If unchecked, no one will see this layer') }}">
        <input class="form-check-input" type="checkbox" id="layer-{{key}}-visible" value="1" name="visible" {% if visible %}checked{% endif %}>
        <label class="form-check-label" for="layer-{{key}}-visible">{{ __('Visible') }}</label>
    </div>

    <div class="form-check form-check-inline" data-toggle="tooltip" data-placement="top" title="{{ __('Elements in this layer cannot be edited') }}">
        <input class="form-check-input" type="checkbox" id="layer-{{key}}-locked" value="1" name="locked" {% if locked %}checked{% endif %}>
        <label class="form-check-label" for="layer-{{key}}-locked">{{ __('Locked') }}</label>
    </div>

    <div class="form-check form-check-inline" data-toggle="tooltip" data-placement="top" title="{{ __("This layer will receive character's tokens") }}">
        <input class="form-check-input" type="checkbox" id="layer-{{key}}-token" value="1" name="token" {% if token %}checked{% endif %}>
        <label class="form-check-label" for="layer-{{key}}-token">{{ __('Tokens') }}</label>
    </div>

    <div class="form-check form-check-inline" data-toggle="tooltip" data-placement="top" title="{{ __('This layer will only be visible by GMs') }}">
        <input class="form-check-input" type="checkbox" id="layer-{{key}}-gm" value="1" name="gm" {% if gm %}checked{% endif %}>
        <label class="form-check-label" for="layer-{{key}}-gm">{{ __('GM Only') }}</label>
    </div>

    <div class="form-check form-check-inline" data-toggle="tooltip" data-placement="top" title="{{ __('Players can draw on this layer') }}">
        <input class="form-check-input" type="checkbox" id="layer-{{key}}-drawings" value="1" name="drawings" {% if drawings %}checked{% endif %}>
        <label class="form-check-label" for="layer-{{key}}-drawings">{{ __('Drawings') }}</label>
    </div>
</div>

<div class="form-group">
    <div class="d-flex justify-content-between align-items-center">
        <a href="#" class="btn btn-primary btn-apply">{{ __('Apply') }}</a>
        <a href="#" class="text-danger delete-layer-btn">{{ __('Delete layer') }}</a>
    </div>
</div>