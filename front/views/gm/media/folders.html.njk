{% for folder in folders %}
<div class="col-3">
    <div class="media-wrapper mr-2 folder-item" title="{{ folder.name|e }}" data-id="{{ folder.id }}">
        <div class="d-flex align-items-center">
            <i class="fas fa-folder mr-2"></i>
            <span class="flex-grow-2 folder-name">{{ folder.name }}</span>
        </div>
    </div>
</div>
{% endfor %}