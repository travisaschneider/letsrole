{% for media in medias %}
    {% set name = media.filename %}

    {% if media.title %}
        {% set name = media.title %}
    {% endif %}

    <div class="col-4">
        <div class="media-thumbnail media-entry"
             style="background-image: url('{{ cdnThumbnailUrl }}/{{ media.path }}')"
             draggable="true"
             data-thumbnail="{{ cdnThumbnailUrl }}/{{ media.path }}"
             data-url="{{ cdnReadUrl }}/{{ media.path }}"
             data-id="{{ media.id }}"
             data-type="{{ media.type }}"
            >
            <div class="info" title="{{ name|e }}">
                <label for="media-{{ media.id }}">
                    <input type="checkbox" id="media-{{ media.id }}">
                    <i class="{{ get_icon(media) }}"></i>
                    <span class="name name-container">{{ name }}</span>
                </label>
            </div>
        </div>
    </div>
{% endfor %}