<div class="quick-music">
    <div id="youtube-container" class="d-none">

    </div>

    <div class="d-flex align-items-center">
        <div class="video-time">
            <span class="current-time"></span>
        </div>
        <div class="seek-controls flex-grow-1 control">
            <div class="pointed-time d-none">123:45:56</div>
            <div class="progress" style="height: 8px;">
                <div class="progress-bar" role="progressbar" style="width: 25%;"></div>
            </div>
        </div>
        <div class="video-time">
            <span class="total-time"></span>
        </div>
    </div>

    <div class="controls align-items-center">

        {% if isGm %}
            <a href="#" class="control play-btn play-ctrl">
                <i class="fas fa-play"></i>
            </a>
            <a href="#" class="control pause-btn play-ctrl">
                <i class="fas fa-pause"></i>
            </a>
            <a href="#" class="control repeat-btn play-ctrl">
                <i class="fas fa-repeat"></i>
            </a>
            <a href="#" class="control shuffle-btn flow-ctrl">
                <i class="fas fa-random"></i>
            </a>
            <a href="#" class="control prev-btn flow-ctrl">
                <i class="fas fa-step-backward"></i>
            </a>
            <a href="#" class="control next-btn flow-ctrl">
                <i class="fas fa-step-forward"></i>
            </a>
        {% endif %}

        <div class="volume-container d-none">
            <input type="range" class="volume-control" min="0" max="100" value="70">
        </div>

        <a href="#" class="control volume-btn">
            <i class="fas fa-volume"></i>
        </a>
    </div>

    {% if isGm %}
    <div class="d-flex align-items-center mt-2 mx-2">
        <input class="quick-play-input flex-grow-1" type="text" placeholder="{{ __('Quick Play YouTube video URL...') }}">
        <a href="#" class="btn btn-secondary quick-play-btn ml-2"><i class="fas fa-play-circle"></i></a>
    </div>

    <div class="d-flex mt-2 align-items-center mx-2">
        <select class="quick-playlist flex-grow-1">
            <option value="" class="fixed">{{ __('Quick Play one of your playlist...') }}</option>
        </select>
        <a href="#" class="btn btn-secondary quick-playlist-btn ml-2"><i class="fas fa-play-circle"></i></a>
    </div>

    <div class="toolbar d-flex">
        <a href="#" class="manager-btn"><i class="fas fa-list-music"></i> {{ __('Open music manager') }}</a>
    </div>
    {% endif %}
</div>