                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row no-gutters">
                {% for color in colors %}
                <div class="col">
                    <div class="bar-color-selector bar2-color" data-color="{{ color }}" style="background-color: {{ color }}"></div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>