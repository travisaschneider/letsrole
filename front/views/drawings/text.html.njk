<div class="drawing-options" data-tool="arrow">
    <div class="d-flex">
        <div class="form-group mr-2">
            <label>{{ __('Font Size') }}</label>
            <input type="number" step="1" min="0" max="300" class="form-control attribute" data-bind="size" data-type="float" value="{{size}}">
        </div>

        <div class="form-group">
            <label>{{ __('Color') }}</label>
            <input class="form-control color-picker attribute" data-bind="color" value="{{color}}" data-type="color">
        </div>
    </div>

    <div class="form-group">
        <label>{{ __('Text') }}</label>
        <textarea class="form-control attribute" rows="10" data-bind="text" data-delay="true">{{text}}</textarea>
    </div>
</div>