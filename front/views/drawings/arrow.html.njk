<div class="drawing-options" data-tool="arrow">
    <div class="d-flex">
        <div class="form-group mr-2">
            <label>{{ __('Weight') }}</label>
            <input type="number" step="1" min="0" max="30" class="form-control attribute" data-bind="weight" data-type="float" value="{{weight}}">
        </div>

        <div class="form-group">
            <label>{{ __('Color') }}</label>
            <input class="form-control color-picker attribute" data-bind="color" value="{{color}}" data-type="color">
        </div>
    </div>

    <div class="d-flex">
        <div class="form-group mr-2">
            <label>{{ __('Pointer size') }}</label>
            <input type="number" step="1" min="0" max="50" class="form-control attribute" data-bind="arrowSize" data-type="float" value="{{arrowSize}}">
        </div>

        <div class="form-group">
            <label>{{ __('Pointer at beginning') }}</label>

            <div class="custom-control custom-checkbox">
                <input type="checkbox" class="custom-control-input attribute" id="drawing-arrow-begin" data-bind="begin" data-type="boolean" value="1" {% if begin %}checked{% endif %}>
                <label class="custom-control-label" for="drawing-arrow-begin"></label>
            </div>
        </div>
    </div>
</div>