<div class="encyclopedia-page-edit p-2">
    <div class="d-flex">
        <div class="form-group mr-2 flex-grow-1">
            <label for="page-title-{{ page.id }}">{{ __('Title') }}</label>
            <input type="text" class="form-control" name="title" id="page-title-{{ page.id }}" value="{{ page.title }}">
        </div>
        <div class="form-group icons">
            <label for="page-icon-{{ page.id }}">{{ __('Icon') }}</label>
            <div class="d-flex">
                {% for icon in icons %}
                <a href="#" class="icon {% if icon.type == page.icon %}active{% endif %}" data-icon="{{ icon.type }}"><i class="{{ icon.icon }}"></i></a>
                {% endfor %}
            </div>
        </div>
    </div>

    {% if page.type == "pdf" %}
        <div class="content"><i class="fas fa-file-pdf"></i> {{ __("The content of this entry is an uploaded PDF, so you can't edit it directly.") }}</div>
    {% else %}
        <div class="content">{{ page.content|safe }}</div>
    {% endif %}

    <div class="form-group mt-2">
        <input type="text" class="form-control" name="tags" id="page-tags-{{ page.id }}" value="{{ page.tagsAsString }}" placeholder="{{ __('Tags') }}">
    </div>
</div>