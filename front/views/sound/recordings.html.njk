<div class="d-flex justify-content-between align-items-center">
    <h2 class="mb-3">
        <i class="fas fa-microphone"></i>
        {{ __('My Recordings') }}
    </h2>
    <a href="#" class="go-back-btn text-light"><i class="fas fa-caret-left"></i> {{ __('Go back') }}</a>
</div>

<div class="row">
    {% for recording in recordings %}
    <div class="col-6 mb-2 sound-entry" data-path="{{ recording.path }}" data-id="{{ recording.id }}" draggable="true" data-type="recording">
        <div class="d-flex">
            <a href="#" class="play-btn">
                <i class="fas fa-play"></i>
                <i class="fas fa-stop"></i>
            </a>
            <div class="ml-2">
                <strong class="title">{{ recording.title }}</strong>
                <small class="actions">
                    <a href="#" class="rename-btn"><i class="fas fa-quote-right"></i> {{ __('Rename') }}</a>
                    <a href="#" class="delete-btn"><i class="fas fa-trash-alt"></i> {{ __('Delete') }}</a>
                </small>
            </div>
        </div>
    </div>
    {% endfor %}
</div>

{% if hasPagination %}
<nav>
    <ul class="pagination justify-content-end">
        {% if prev %}
            <li class="page-item"><a class="page-link" href="#" data-page="{{ prevPage }}"><i class="fas fa-angle-left"></i> {{ __('Previous') }}</a></li>
        {% endif %}

        {% if next %}
        <li class="page-item "><a class="page-link" href="#" data-page="{{ nextPage }}">{{ __('Next') }} <i class="fas fa-angle-right"></i></a></li>
        {% endif %}
    </ul>
</nav>
{% endif %}