{% for sound in sounds %}
<div class="sound-entry" data-path="{{ sound.path }}" data-id="{{ sound.id }}" data-local-id="{{ sound.localId }}" data-type="{{ sound.type }}" draggable="true">
    <div class="d-flex">
        <a href="#" class="play-btn">
            <i class="fas fa-play"></i>
            <i class="fas fa-stop"></i>
        </a>
        <div class="ml-2">
            <strong>{{ sound.title }}</strong>
        </div>
    </div>
</div>
{% endfor %}