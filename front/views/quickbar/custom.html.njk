<div class="quickbar-custom">
    <div class="form-group">
        <label>{{ __('Title') }}</label>
        <input type="text" name="title" class="form-control" value="{{ title|e }}">
    </div>
    <div class="form-group">
        <a href="#" class="btn btn-secondary btn-dice-roller">
            <i class="fas fa-dice"></i>
            {{ __('Use the Roll Maker') }}
        </a>
    </div>
    <div class="form-group">
        <label>{{ __('Action type') }}</label>
        <select class="form-control" name="type">
            <option value="visible" {% if type == "visible" %}selected{% endif %}>{{ __('Normal roll') }}</option>
            <option value="gm" {% if type == "gm" %}selected{% endif %}>{{ __('Roll for GM & You') }}</option>
            <option value="gmonly" {% if type == "gmonly" %}selected{% endif %}>{{ __('Roll for GM only') }}</option>
        </select>
    </div>
    <div class="form-group">
        <label>{{ __('Dice formula') }}</label>
        <input type="text" name="formula" class="form-control" value="{{ formula|e }}">
        <div class="invalid-feedback">
            {{ __('Please provide a formula.') }}
        </div>
    </div>
    {% if sound %}
    <div class="form-check">
        <input class="form-check-input" type="checkbox" value="" id="remove-sound">
        <label class="form-check-label" for="remove-sound">
            {{ __('Remove sound %{sound}', { sound: sound.title })}}
        </label>
    </div>
    {% endif %}

    <div class="form-group">
        <a href="#" class="btn btn-secondary submit-btn">{{ __('Save custom action') }}</a>
    </div>
</div>