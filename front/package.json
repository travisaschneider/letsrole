{
  "name": "frontend",
  "version": "2.0.0",
  "description": "Let's Role's TableTop RPG gaming frontend",
  "main": "app.js",
  "scripts": {
    "dev": "webpack --config webpack/webpack.config.dev.js & npm run style-dev & npm run sheet-style && fg",
    "style-dev": "sass --watch sass/app.scss:../website/public/css/play.css",
    "token-editor": "webpack --config webpack/webpack.token-editor.config.dev.js",
    "sheet-style": "sass --watch sass/sheet.scss:../website/public/css/sheet.css",
    "skins": "concurrently --kill-others 'sh compile-skin.sh fantasy' 'sh compile-skin.sh scifi' 'sh compile-skin.sh victorian' 'sh compile-skin.sh dark-fantasy' 'sh compile-skin.sh cyberpunk' 'sh compile-skin.sh investigation' 'sh compile-skin.sh demonic' 'sh compile-skin.sh notebook'",
    "table-skins": "concurrently --kill-others 'sh compile-table-skin.sh cyberpunk' 'sh compile-table-skin.sh medieval' 'sh compile-table-skin.sh detective' 'sh compile-table-skin.sh hud' 'sh compile-table-skin.sh space' 'sh compile-table-skin.sh dragons' 'sh compile-table-skin.sh vampire'",
    "compile-template": "./node_modules/nunjucks/bin/precompile views --include '\\.njk$' > ../website/public/js/play-template.js",
    "compile-template-website": "./node_modules/nunjucks/bin/precompile views/website --include '\\.njk$' > ../website/public/js/website-template.js",
    "extract-i18n": "node ./node_modules/i18next-scanner/bin/cli.js",
    "website:sheet": "webpack --config webpack/webpack.website.sheet.config.dev.js",
    "website:embed": "webpack --config webpack/webpack.website.embed.config.dev.js",
    "website:dice-tester": "webpack --config webpack/webpack.website.dice-tester.config.dev.js",
    "website:mobile-dice-roller": "webpack --config webpack/webpack.website.mobile-dice-roller.config.dev.js",
    "website:live-dice-demo": "webpack --config webpack/webpack.website.live-dice-demo.config.dev.js",
    "website:image-upload": "webpack -d --config webpack/webpack.website.image-upload.config.dev.js",
    "prod": "concurrently \"npm run build:frontapp\" \"npm run build:website:sheet\" \"npm run build:website:embed\" \"npm run build:token-editor\" \"npm run compile-template\" \"npm run compile-template-website\" \"npm run build:style\" \"npm run build:sheet-style\" \"npm run build:website:dice-tester\" \"npm run build:table-skins\" \"npm run build:website:live-dice-demo\" \"npm run build:website:mobile-dice-roller\"",
    "build:frontapp": "webpack --config webpack/webpack.config.prod.js",
    "build:token-editor": "webpack --config webpack/webpack.token-editor.config.prod.js",
    "build:website:sheet": "webpack --config webpack/webpack.website.sheet.config.prod.js",
    "build:website:embed": "webpack --config webpack/webpack.website.embed.config.prod.js",
    "build:website:dice-tester": "pegjs --plugin ./node_modules/ts-pegjs/src/tspegjs -o src/Website/grammar.ts --cache shared/grammar.pegjs && webpack --config webpack/webpack.website.dice-tester.config.prod.js",
    "build:website:mobile-dice-roller": "webpack --config webpack/webpack.website.mobile-dice-roller.config.prod.js",
    "build:website:live-dice-demo": "pegjs --plugin ./node_modules/ts-pegjs/src/tspegjs -o src/Website/grammar.ts --cache shared/grammar.pegjs && webpack --config webpack/webpack.website.live-dice-demo.config.prod.js",
    "build:website:image-upload": "pegjs --plugin ./node_modules/ts-pegjs/src/tspegjs -o src/Website/grammar.ts --cache shared/grammar.pegjs && webpack -d --config webpack/webpack.website.image-upload.config.prod.js",
    "build:style": "sass sass/app.scss:../website/public/css/play.css",
    "build:sheet-style": "sass sass/sheet.scss:../website/public/css/sheet.css",
    "build:table-skins": "sh compile-table-skin-prod.sh cyberpunk && sh compile-table-skin-prod.sh medieval && sh compile-table-skin-prod.sh detective && sh compile-table-skin-prod.sh hud && sh compile-table-skin-prod.sh space && sh compile-table-skin-prod.sh dragons && sh compile-table-skin-prod.sh vampire",
    "test": "npx jest"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/letsrole/front"
  },
  "author": "Jonathan Prevost",
  "license": "LGPL-3.0-or-later",
  "dependencies": {
    "@ckeditor/ckeditor5-alignment": "^37.0.1",
    "@ckeditor/ckeditor5-autosave": "^37.0.1",
    "@ckeditor/ckeditor5-build-classic": "^37.0.1",
    "@ckeditor/ckeditor5-dev-utils": "^37.0.1",
    "@ckeditor/ckeditor5-dev-webpack-plugin": "^31.1.13",
    "@ckeditor/ckeditor5-font": "^37.0.1",
    "@ckeditor/ckeditor5-image": "^37.0.1",
    "@ckeditor/ckeditor5-media-embed": "^37.0.1",
    "@ckeditor/ckeditor5-table": "^37.0.1",
    "@ckeditor/ckeditor5-theme-lark": "^37.0.1",
    "@ckeditor/ckeditor5-ui": "^37.0.1",
    "@fortawesome/fontawesome-free": "^5.15.4",
    "@wizpanda/super-gif": "^0.0.5",
    "audiobuffer-to-wav": "^1.0.0",
    "bootstrap": "^4.6.2",
    "bootstrap-colorpicker": "^3.4.0",
    "cannon": "^0.6.2",
    "caret-xy": "^2.0.3",
    "css-loader": "^6.5.0",
    "i18next-scanner": "^3.1.0",
    "inversify": "^6.2.2",
    "jquery": "^3.6.0",
    "js-engine": "git+https://gitlab.com/letsrole/js-engine#semver:1.3.3",
    "konva": "^8.3.14",
    "lamejs": "^1.2.0",
    "martinez-polygon-clipping": "^0.7.1",
    "node-polyglot": "^2.4.2",
    "nunjucks": "^3.2.3",
    "pegjs": "^0.10.0",
    "polybooljs": "^1.2.0",
    "postcss-loader": "^6.2.0",
    "raw-loader": "^4.0.2",
    "reflect-metadata": "^0.2.2",
    "sass": "^1.54.2",
    "simplify-ts": "^1.0.2",
    "style-loader": "^3.3.1",
    "three": "~0.122",
    "ts-loader": "^9.2.6",
    "ts-pegjs": "^1.2.1",
    "tunajs": "^1.0.15",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/cannon": "^0.1.7",
    "@types/ckeditor__ckeditor5-core": "^33.0.3",
    "@types/dom-inputevent": "^1.0.6",
    "@types/jest": "^29.5.14",
    "@types/jquery": "^3.5.4",
    "@types/lodash.clonedeep": "^4.5.6",
    "@types/node": "^10.17.44",
    "@types/node-polyglot": "^2.4.2",
    "@types/nunjucks": "^3.2.0",
    "@types/quill": "^2.0.4",
    "@types/three": "^0.93.31",
    "@types/uuid": "^3.4.9",
    "@types/youtube": "0.0.38",
    "@typescript-eslint/eslint-plugin": "^5.53.0",
    "@typescript-eslint/parser": "^5.53.0",
    "concurrently": "^6.5.1",
    "eslint": "^8.34.0",
    "filemanager-webpack-plugin": "^6.1.7",
    "jest": "^29.7.0",
    "prettier": "^2.8.4",
    "sass": "^1.54.0",
    "terser-webpack-plugin": "^5.2.5",
    "ts-jest": "^29.3.2",
    "tsconfig-paths-webpack-plugin": "^3.5.1",
    "typescript": "^4.4.4",
    "webpack": "^5.59.0",
    "webpack-cli": "^4.10.0"
  }
}
